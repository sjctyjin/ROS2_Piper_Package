      <box size="0.01 0.01 0.01"/>
    </geometry>
    <material name="transparent">
      <color rgba="0.0 0.0 0.0 0.0"/>  <!-- 完全透明 -->
    </material>
  </visual>
</link>



<joint name="dummy_joint1" type="revolute">
  <origin xyz="0.0 0.0 0.0815" rpy="0 0 -1.57"/>
  <parent link="base_link"/>
  <child link="link1_v1_1"/>
  <axis xyz="-0.0 0.0 1.0"/>
  <limit upper="3.054326" lower="-2.96706" effort="100" velocity="100"/>
</joint>

